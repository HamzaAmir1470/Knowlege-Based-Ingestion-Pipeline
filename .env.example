# ---------- Server ----------
PORT=3000

# ---------- Gemini ----------
# Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
# Maximum characters of cleaned Markdown sent to Gemini
GEMINI_MAX_INPUT_CHARS=120000

# ---------- Upload ----------
MAX_FILE_SIZE_MB=10

# ---------- Recursive chunking ----------
# Target chunk length in characters, and how many characters carry over between neighbours
CHUNK_SIZE=800
CHUNK_OVERLAP=100

# ---------- Semantic chunking ----------
# A chunk can grow up to SEMANTIC_MAX_CHARS. Topic shifts only split once SEMANTIC_MIN_CHARS is reached.
SEMANTIC_MIN_CHARS=300
SEMANTIC_MAX_CHARS=1200
# 0 to 1. Higher values split more often. Based on shared keywords between paragraphs.
SEMANTIC_SIMILARITY_THRESHOLD=0.12

# ---------- Parent-child tree ----------
# Parents are sections up to this heading level (1 = "#", 2 = "##")
PARENT_HEADING_LEVEL=2
PARENT_MAX_CHARS=3000
CHILD_CHUNK_SIZE=400
CHILD_CHUNK_OVERLAP=50

# ---------- Demo ----------
# Pause (ms) after each local stage so the timeline is easy to watch. Set to 0 to run at full speed.
STAGE_DELAY_MS=450
